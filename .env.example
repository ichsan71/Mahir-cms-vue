# Salin file ini menjadi .env lalu isi nilainya.
# CATATAN: semua VITE_* bersifat build-time — di-inline saat `npm run build`,
# jadi nilainya harus tersedia SEBELUM/SAAT build image.

# Endpoint GraphQL backend.
# - Diisi  → Apollo memakai HttpLink ke backend (autentikasi nyata).
# - Kosong → Apollo memakai skema mock in-memory (hanya akun admin).
# Contoh: https://api.maztafarma.co.id/graphql
VITE_GRAPHQL_URI=

# Google Maps Platform API key (pemilihan alamat cabang).
# Aktifkan: Maps JavaScript API + Places API + Geocoding API.
# Kosong = fitur peta pada form alamat cabang nonaktif.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (push notification) — konfigurasi web (tidak rahasia).
# CATATAN: nilai ini HARUS sama dengan yang di-hardcode pada
# public/firebase-messaging-sw.js (service worker tidak bisa membaca env).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# VAPID key / Web Push certificate (WAJIB DIISI untuk FCM).
# Firebase Console → Project Settings → Cloud Messaging → "Web Push certificates".
# Tanpa ini FCM token tidak bisa diambil.
VITE_FIREBASE_VAPID_KEY=
